{% comment %}
  Optional product-level multi_line_text_field values. Native details/summary
  provides keyboard interaction without adding JavaScript or purchase handlers.
{% endcomment %}
{%- assign detail_keys = 'benefits,usage,care' | split: ',' -%}
{%- capture detail_rows -%}
  {%- for detail_key in detail_keys -%}
    {%- assign detail_value = product.metafields.nuuma[detail_key].value -%}
    {%- if detail_value != blank -%}
      {%- assign detail_label = 'products.product.nuuma.' | append: detail_key -%}
      <div class="product__accordion accordion quick-add-hidden">
        <details id="NuumaDetail-{{ section_id }}-{{ block.id }}-{{ detail_key }}">
          <summary>
            <span class="nuuma-product-details__title">{{ detail_label | t }}</span>
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </summary>
          <div class="accordion__content rte">{{ detail_value | escape | newline_to_br }}</div>
        </details>
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if detail_rows != blank -%}
  <div class="nuuma-product-details" {{ block.shopify_attributes }}>{{ detail_rows }}</div>
{%- endif -%}
